# Copy this file to .env (never committed) and replace the CHANGE_ME values.
# Values below are the ones used inside docker-compose (service names as hosts).

# --- PostgreSQL (3 Spring services, each with its own DB) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/telemetry_db
SPRING_DATASOURCE_USERNAME=aegis
SPRING_DATASOURCE_PASSWORD=aegis

# --- Kafka (all) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Security ---
# 256-bit secret (generate with: openssl rand -base64 32)
AEGIS_JWT_SECRET=CHANGE_ME
# shared secret for service-to-service gRPC calls
AEGIS_INTERNAL_TOKEN=CHANGE_ME

# --- gRPC addresses ---
PROBE_GRPC_ADDR=aegis-probe:50051
TELEMETRY_GRPC_ADDR=telemetry-service:9191
SHIELD_GRPC_ADDR=shield-service:9192
ENGINE_GRPC_ADDR=shield-engine:8083

# --- LLM (commander-service) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# --- Go probe ---
PROBE_SERVERS=web-01,web-02,api-01,db-01,cache-01,worker-01
PROBE_TICK_MS=500
