<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared module (owner: all three). Generates the Java gRPC stubs (package io.aegisops.proto.v1)
  from ../proto/aegisops/v1/*.proto. A Spring service uses them by adding:
      <dependency><groupId>io.aegisops</groupId><artifactId>aegis-proto</artifactId><version>${project.version}</version></dependency>
  protoc and grpc-java versions come from the Spring Boot parent, so everything stays aligned.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>io.aegisops</groupId>
    <artifactId>aegis-proto</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>aegis-proto</name>
    <description>AegisOps shared gRPC contracts (generated Java stubs)</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <configuration>
                    <sourceDirectories>
                        <sourceDirectory>${project.basedir}/../proto</sourceDirectory>
                    </sourceDirectories>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
